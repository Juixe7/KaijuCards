# ==============================================================================
# KaijuCards - Environment Configuration Template
# Copy this file to '.env' (for local development) or set these in your hosting environment (e.g. Render / Vercel)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Render / Local)
# ------------------------------------------------------------------------------
PORT=8080
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/meta_clash?sslmode=disable
JWT_SECRET=super_secret_dev_key_12345
JWT_EXPIRY=24h
ALLOWED_ORIGIN=http://localhost:3000
JIKAN_BASE_URL=https://api.jikan.moe/v4
JIKAN_TIMEOUT=5s

# Gemini API Key (Required for anime card stat generation & lore text)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ------------------------------------------------------------------------------
# Frontend Configuration (Vercel / Local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/ws
